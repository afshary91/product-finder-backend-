# این فایل رو کپی کن به نام .env و مقادیر واقعی رو جایگزین کن

# کلید API که از پنل کاوه‌نگار (kavenegar.com) می‌گیری
KAVENEGAR_API_KEY=your-kavenegar-api-key

# نام قالب (Template) که در پنل کاوه‌نگار برای OTP ساختی
KAVENEGAR_TEMPLATE=verify

# یک رشته تصادفی و طولانی برای امضای توکن‌ها - این رو محرمانه نگه دار
JWT_SECRET=change-this-to-a-long-random-string

# پورتی که سرور روش اجرا می‌شه (لیارا خودش این رو ست می‌کنه، نیازی به تغییر نیست)
PORT=3000
